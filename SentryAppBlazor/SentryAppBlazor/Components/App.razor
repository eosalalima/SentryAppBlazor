<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    @* Keep the reconnect rules available even when a proxy or browser still has an
       older app.css cached from before the reconnect UI was introduced. *@
    <link rel="stylesheet" href="app.css?v=20260828.1" />
    <style>
        #components-reconnect-modal,
        #components-reconnect-modal .reconnect-card > div {
            display: none;
        }

        #components-reconnect-modal.components-reconnect-show,
        #components-reconnect-modal.components-reconnect-failed,
        #components-reconnect-modal.components-reconnect-rejected,
        #components-reconnect-modal.components-reconnect-show .components-reconnect-show,
        #components-reconnect-modal.components-reconnect-failed .components-reconnect-failed,
        #components-reconnect-modal.components-reconnect-rejected .components-reconnect-rejected {
            display: grid;
        }
    </style>
    <link rel="stylesheet" href="SentryAppBlazor.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="components-reconnect-modal" class="reconnect-modal components-reconnect-hide" role="status" aria-live="polite">
        <div class="reconnect-card">
            <div class="components-reconnect-show">
                <span class="reconnect-spinner" aria-hidden="true"></span>
                <strong>Connection interrupted</strong>
                <span>Restoring the monitor…</span>
            </div>
            <div class="components-reconnect-failed">
                <strong>Unable to reconnect</strong>
                <span>Check the server or network connection, then try again.</span>
                <button id="components-reconnect-button" type="button">Try again</button>
            </div>
            <div class="components-reconnect-rejected">
                <span class="reconnect-spinner" aria-hidden="true"></span>
                <strong>Monitor restarted</strong>
                <span>Loading a fresh connection…</span>
            </div>
        </div>
    </div>
    <script src="reconnect.js?v=20260828.1"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
