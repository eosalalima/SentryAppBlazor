@page "/settings"
@inject MonitoringSettingsStore SettingsStore
@inject NavigationManager Navigation

<PageTitle>Settings · Sentry</PageTitle>
<header class="monitor-header compact">
    <a class="brand" href="/"><span class="brand-mark">DGL</span><span><strong>SENTRY MONITOR</strong><small>ADMINISTRATION</small></span></a>
    <a class="back-link" href="/">← Return to monitor</a>
</header>
<div class="settings-page">
    <div class="settings-title"><span class="eyebrow">SYSTEM ADMINISTRATION</span><h1>Monitoring Settings</h1><p>Update monitoring behavior and save changes to <code>sentryconfig.json</code>.</p></div>
    <div class="notice"><strong>Live integration pending schema confirmation</strong><span>DeviceLogs columns, direction mapping, device source, personnel relationship, and mobile-number source have not been supplied. Live queries and SMS transmission are intentionally disabled rather than guessed.</span></div>

    <EditForm Model="Model" FormName="monitoring-settings">
        <section class="settings-card">
            <h2>Operation</h2><div class="form-grid">
            <label>Operating mode<select @bind="Model.OperatingMode"><option>Demo</option><option>Live</option></select><small>Demo uses the production display pipeline without database writes.</small></label>
            <label>Device to monitor<input @bind="Model.DeviceId" /><small>Use <code>all</code> until the confirmed device source is connected.</small></label>
            <label>Polling interval<input type="number" min="250" max="60000" @bind="Model.PollingInterval" /><ValidationMessage For="() => Model.PollingInterval" /></label>
            <label>Startup lookback<input type="number" min="0" max="3600" @bind="Model.LookbackSecondsOnStart" /><ValidationMessage For="() => Model.LookbackSecondsOnStart" /></label>
            <label>Maximum rows per poll<input type="number" min="1" max="500" @bind="Model.MaxRowsPerPoll" /><ValidationMessage For="() => Model.MaxRowsPerPoll" /></label></div>
        </section>
        <section class="settings-card"><h2>Display & photos</h2><div class="form-grid">
            <label>Spotlight duration<input type="number" min="1000" max="60000" @bind="Model.HighlightDisplayDuration" /><ValidationMessage For="() => Model.HighlightDisplayDuration" /></label>
            <label>Feed retention<input type="number" min="1000" max="300000" @bind="Model.FeedRetentionDuration" /><ValidationMessage For="() => Model.FeedRetentionDuration" /></label>
            <label class="wide">Protected photo directory<input @bind="Model.PhotosPath" /><small>The browser receives only <code>/photos/&#123;id&#125;</code> URLs.</small></label></div>
        </section>
        <section class="settings-card"><h2>Notifications</h2><div class="form-grid">
            <label>SMS status<select @bind="Model.SmsEnabled"><option value="true">Enabled</option><option value="false">Disabled</option></select></label>
            <label>Serial port<input @bind="Model.SmsComPort" /><ValidationMessage For="() => Model.SmsComPort" /></label>
            <label>SMS timeout<input type="number" min="5" max="120" @bind="Model.SmsTimeoutSeconds" /><ValidationMessage For="() => Model.SmsTimeoutSeconds" /></label>
            <label>SMS retry count<input type="number" min="0" max="5" @bind="Model.SmsRetryCount" /><ValidationMessage For="() => Model.SmsRetryCount" /></label></div>
        </section>
        <div class="settings-actions">
            <button type="button" class="control-button" @onclick="ApplyAsync">Apply</button>
            <button type="button" class="control-button" @onclick="CloseSettings">Cancel</button>
        </div>
    </EditForm>
</div>

@code {
    private MonitoringOptions Model { get; set; } = new();
    protected override void OnInitialized() => Model = SettingsStore.Current;

    private async Task ApplyAsync()
    {
        await SettingsStore.SaveAsync(Model);
        CloseSettings();
    }

    private void CloseSettings() => Navigation.NavigateTo("/", forceLoad: true);
}
