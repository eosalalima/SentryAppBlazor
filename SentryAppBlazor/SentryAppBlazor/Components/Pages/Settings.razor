@page "/settings"
@inject MonitoringSettingsStore SettingsStore
@inject NavigationManager Navigation
@inject ILogger<Settings> Logger
@using SentryAppBlazor.Turnstile

<PageTitle>Settings · Sentry</PageTitle>
<header class="monitor-header compact">
    <a class="brand" href="/"><span class="brand-mark">DGL</span><span><strong>SENTRY MONITOR</strong><small>ADMINISTRATION</small></span></a>
    <a class="back-link" href="/">← Return to monitor</a>
</header>
<div class="settings-page">
    <div class="settings-title"><span class="eyebrow">SYSTEM ADMINISTRATION</span><h1>Monitoring Settings</h1><p>Update monitoring behavior and save changes to <code>sentryconfig.json</code>.</p></div>
    <div class="notice"><strong>Demo mode uses all configured data sources</strong><span>Demo selects an active person from Personnels, a device from Access Control, and inserts the sample event into Access Control DeviceLogs. STAFF and STUDENT are used for directory/mobile lookups.</span></div>

    <EditForm EditContext="editContext" FormName="monitoring-settings">
        <DataAnnotationsValidator />
        <section class="settings-card">
            <h2>Operation</h2><div class="form-grid">
            <label>Operating mode<select @onchange="UpdateOperatingMode"><option value="Demo" selected="@IsOperatingMode("Demo")">Demo</option><option value="Live" selected="@IsOperatingMode("Live")">Live</option></select><small>Demo writes valid sample records to DeviceLogs and requires active personnel and device records.</small></label>
            <label>Automatic demo logs<select @onchange="UpdateAutomaticDemoLogs"><option value="enabled" selected="@Model.EnableSimulatedLogs">Enabled</option><option value="disabled" selected="@(!Model.EnableSimulatedLogs)">Disabled</option></select><small>Additional write-safety switch; it has no effect in Live mode.</small></label>
            <label>Device to monitor<input @bind="Model.DeviceId" /><small>Use <code>all</code> until the confirmed device source is connected.</small></label>
            <label>Polling interval<input type="number" min="250" max="60000" @bind="Model.PollingInterval" /><ValidationMessage For="() => Model.PollingInterval" /></label>
            <label>Startup lookback<input type="number" min="0" max="3600" @bind="Model.LookbackSecondsOnStart" /><ValidationMessage For="() => Model.LookbackSecondsOnStart" /></label>
            <label>Maximum rows per poll<input type="number" min="1" max="500" @bind="Model.MaxRowsPerPoll" /><ValidationMessage For="() => Model.MaxRowsPerPoll" /></label></div>
        </section>
        <section class="settings-card">
            <h2>Database</h2><div class="form-grid">
            <label class="wide">Access Control connection string<input @bind="ConnectionStrings.AccessControlDb" autocomplete="off" spellcheck="false" /><small>Connection used to read access-control events and write demo device logs.</small></label>
            <label class="wide">STAFF connection string<input @bind="ConnectionStrings.StaffDb" autocomplete="off" spellcheck="false" /><small>Connection used for staff directory lookups.</small></label>
            <label class="wide">STUDENT connection string<input @bind="ConnectionStrings.StudentDb" autocomplete="off" spellcheck="false" /><small>Connection used for student directory lookups.</small></label>
            <label class="wide">Personnels connection string<input @bind="ConnectionStrings.PersonnelsDb" autocomplete="off" spellcheck="false" /><small>Connection used for personnel identity, names, photos, and demo access numbers.</small></label></div>
        </section>
        <section class="settings-card">
            <h2>Demo safety</h2><div class="form-grid">
            <label>Live database mode<select @onchange="UpdateLiveDatabaseMode"><option value="enabled" selected="@SimulationModel.IsLiveMode">Enabled</option><option value="disabled" selected="@(!SimulationModel.IsLiveMode)">Disabled</option></select><small>Keep enabled whenever the configured connection points to production.</small></label>
            <label>Minimum log delay (seconds)<input type="number" min="1" max="3600" @bind="SimulationModel.MinimumDelaySeconds" /><ValidationMessage For="() => SimulationModel.MinimumDelaySeconds" /></label>
            <label>Maximum log delay (seconds)<input type="number" min="1" max="3600" @bind="SimulationModel.MaximumDelaySeconds" /><ValidationMessage For="() => SimulationModel.MaximumDelaySeconds" /></label></div>
        </section>
        <section class="settings-card"><h2>Display & photos</h2><div class="form-grid">
            <label>Spotlight duration<input type="number" min="1000" max="60000" @bind="Model.HighlightDisplayDuration" /><ValidationMessage For="() => Model.HighlightDisplayDuration" /></label>
            <label>Feed retention<input type="number" min="1000" max="300000" @bind="Model.FeedRetentionDuration" /><ValidationMessage For="() => Model.FeedRetentionDuration" /></label>
            <label class="wide">Protected photo directory<input @bind="Model.PhotosPath" /><small>The browser receives only <code>/photos/&#123;id&#125;</code> URLs.</small></label></div>
        </section>
        <section class="settings-card"><h2>Notifications</h2><div class="form-grid">
            <label>SMS status<select @onchange="UpdateSmsStatus"><option value="enabled" selected="@Model.SmsEnabled">Enabled</option><option value="disabled" selected="@(!Model.SmsEnabled)">Disabled</option></select></label>
            <label>Serial port<input @bind="Model.SmsComPort" /><ValidationMessage For="() => Model.SmsComPort" /></label>
            <label>SMS timeout<input type="number" min="5" max="120" @bind="Model.SmsTimeoutSeconds" /><ValidationMessage For="() => Model.SmsTimeoutSeconds" /></label>
            <label>SMS retry count<input type="number" min="0" max="5" @bind="Model.SmsRetryCount" /><ValidationMessage For="() => Model.SmsRetryCount" /></label></div>
        </section>
        <div class="settings-actions">
            <button type="button" class="control-button" disabled="@isSaving" @onclick="ApplyAsync">@(isSaving ? "Applying…" : "Apply")</button>
            <a class="control-button" href="/">Cancel</a>
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <span class="save-message error" role="alert">@statusMessage</span>
            }
        </div>
    </EditForm>
</div>

@code {
    private MonitoringOptions Model { get; set; } = new();
    private SimulationOptions SimulationModel { get; set; } = new();
    private ConnectionStringSettings ConnectionStrings { get; set; } = new();
    private EditContext editContext = default!;
    private bool isSaving;
    private string? statusMessage;

    protected override void OnInitialized()
    {
        Model = SettingsStore.Current;
        SimulationModel = SettingsStore.CurrentSimulation;
        ConnectionStrings = SettingsStore.CurrentConnectionStrings;
        editContext = new EditContext(Model);
    }

    private async Task ApplyAsync()
    {
        if (isSaving) return;

        if (!editContext.Validate())
        {
            HandleInvalidSubmit();
            return;
        }

        isSaving = true;
        statusMessage = null;
        try
        {
            await SettingsStore.SaveAsync(Model, SimulationModel, ConnectionStrings);
            Navigation.NavigateTo("/");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to apply monitoring settings");
            statusMessage = "The settings could not be saved. Check that the application can write to sentryconfig.json and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void HandleInvalidSubmit() => statusMessage = "Correct the highlighted settings before applying.";

    private bool IsOperatingMode(string mode) =>
        string.Equals(Model.OperatingMode, mode, StringComparison.OrdinalIgnoreCase);

    private void UpdateOperatingMode(ChangeEventArgs args) =>
        Model.OperatingMode = args.Value?.ToString() ?? Model.OperatingMode;

    private void UpdateAutomaticDemoLogs(ChangeEventArgs args) =>
        Model.EnableSimulatedLogs = IsEnabled(args);

    private void UpdateLiveDatabaseMode(ChangeEventArgs args) =>
        SimulationModel.IsLiveMode = IsEnabled(args);

    private void UpdateSmsStatus(ChangeEventArgs args) =>
        Model.SmsEnabled = IsEnabled(args);

    private static bool IsEnabled(ChangeEventArgs args) =>
        string.Equals(args.Value?.ToString(), "enabled", StringComparison.Ordinal);
}
