@page "/"
@implements IDisposable
@inject TurnstilePollingController Controller
@inject TurnstileLogState Feed
@using SentryAppBlazor.Turnstile
<PageTitle>Sentry · Turnstile Monitor</PageTitle>
<header class="monitor-header"><a class="brand" href="/"><span class="brand-mark">DGL</span><span><strong>DR. GLORIA D. LACSON</strong><small>FOUNDATION COLLEGES</small></span></a><div class="header-center"><span class="eyebrow">TURNSTILE MONITORING SYSTEM</span><strong>All campus gates</strong></div><div class="header-actions"><span class="status-pill @(Controller.IsActive?"online":"")"><i></i>@(Controller.IsActive?"Monitoring active":"Halted")</span><button class="control-button" @onclick="Toggle">@(Controller.IsActive?"■ Stop":"▶ Start")</button></div></header>
<section class="summary-strip"><div><span class="pulse-dot"></span><span><small>SYSTEM</small><b>@(Controller.IsActive?"ONLINE":"PAUSED")</b></span></div><div><small>MONITORED DEVICE</small><b>All Devices</b></div><div><small>RETAINED EVENTS</small><b>@Feed.Entries.Count</b></div><div class="clock"><small>LOCAL TIME</small><b>@DateTime.Now.ToString("HH:mm")</b></div></section>
<div class="monitor-grid"><section class="recent-panel"><div class="section-heading"><div><span class="eyebrow">LIVE HISTORY</span><h1>Recent Activity</h1></div></div>@if(Feed.Entries.Count==0){<div class="empty-state"><h2>No recent activity</h2><p>Start monitoring to receive database events.</p></div>}else{<div class="event-list">@foreach(var item in Feed.Entries){<article class="event-row"><img src="@item.PhotoUrl" alt="Portrait of @item.PersonnelName"/><div class="event-person"><strong>@item.PersonnelName</strong><small>@item.AccessNumber · @item.DeviceName · @item.SmsStatusMessage</small></div><span class="direction">@item.LogType</span><time>@item.TimeLogStamp.ToLocalTime().ToString("g")</time></article>}</div>}</section>
<section class="spotlight-panel"><div class="section-heading"><h2>Current event</h2></div>@if(Feed.Entries.FirstOrDefault() is {} current){<div class="spotlight-card"><div class="photo-frame"><img src="@current.PhotoUrl"/></div><div class="spotlight-copy"><h2>@current.PersonnelName</h2><p>@current.LogType · @current.DeviceName</p><p>@current.Event @current.EventAddress</p><p>@current.SmsStatusMessage</p></div></div>}else{<div class="waiting-card"><h2>Waiting for turnstile logs</h2></div>}</section></div>
@code { protected override void OnInitialized()=>Feed.Changed+=Refresh; void Toggle(){if(Controller.IsActive)Controller.Stop();else Controller.Start();Refresh();} void Refresh()=>_ = InvokeAsync(StateHasChanged); public void Dispose()=>Feed.Changed-=Refresh; }
