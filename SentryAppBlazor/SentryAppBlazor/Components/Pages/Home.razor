@page "/"
@implements IDisposable
@inject TurnstilePollingController Controller
@inject TurnstileLogState Feed
@using SentryAppBlazor.Turnstile
@using SentryAppBlazor.Components.Turnstile
<PageTitle>Sentry · Turnstile Monitor</PageTitle>
<header class="monitor-header"><a class="brand" href="/"><span class="brand-mark">DGL</span><span><strong>DR. GLORIA D. LACSON</strong><small>FOUNDATION COLLEGES</small></span></a><div class="header-center"><span class="eyebrow">TURNSTILE MONITORING SYSTEM</span><strong>All campus gates</strong></div><div class="header-actions"><span class="status-pill @(Controller.IsActive?"online":"")"><i></i>@(Controller.IsActive?"Monitoring active":"Halted")</span><button class="control-button" @onclick="Toggle">@(Controller.IsActive?"■ Stop":"▶ Start")</button><a class="icon-button" href="/settings" aria-label="Open monitoring settings" title="Monitoring settings">⚙</a></div></header>
<section class="summary-strip"><div><span class="pulse-dot"></span><span><small>SYSTEM</small><b>@(Controller.IsActive?"ONLINE":"PAUSED")</b></span></div><div><small>MONITORED DEVICE</small><b>All Devices</b></div><div><small>RECENT EVENTS</small><b>@Feed.Entries.Count</b></div><div class="clock"><small>LOCAL TIME</small><b>@DateTime.Now.ToString("HH:mm")</b></div></section>
<div class="monitor-grid">
    <section class="recent-panel"><div class="section-heading"><div><span class="eyebrow">LIVE HISTORY</span><h1>Recent Activity</h1></div></div><LogQueue Title="IN" Entries="@Feed.InEntries"/><LogQueue Title="OUT / BREAK OUT" Entries="@Feed.OutEntries"/></section>
    <SpotlightPanel Entry="@Feed.Spotlight"/>
</div>
@code {
    protected override void OnInitialized() => Feed.Changed += Refresh;
    private void Toggle() { if(Controller.IsActive) Controller.Stop(); else Controller.Start(); Refresh(); }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Feed.Changed -= Refresh;
}
